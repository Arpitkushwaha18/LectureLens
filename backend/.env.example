# Backend only. Leave optional pairs blank to disable their integration.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
AI_PROVIDER=freegg
# Backend only. Paste your FreeGG bearer key here, without "Bearer " or quotes.
FREEGG_API_KEY=
FREEGG_MODEL=gpt-6.1-sol
# Recommended cost-effective model: gemini-2.5-flash; set with the key, not alone.
GEMINI_MODEL=
# Tested supported model: gemini-3.5-flash. Model listing alone does not prove generation access.
# Local workspace uses private SQLite for ALL outputs (including YouTube).
# Use supabase only after installing/approving hosted lifecycle migrations 005-007.
WORKSPACE_YOUTUBE_STORE=local
LIBRARY_STORE=local_postgres
# Blank disables automatic extraction. Captions only; audio fallback is disabled.
TRANSCRIPTFETCH_API_KEY=
TRANSCRIPT_MAX_CHARACTERS=500000
TRANSCRIPT_MAX_DURATION_SECONDS=18000
# Free local OCR: install Tesseract 5 and eng/hin language packs; npm run ocr:setup
OCR_LANGUAGES=eng+hin
OCR_TESSERACT_PATH=tesseract
# Optional; defaults to backend/.cache/tessdata when provisioned, otherwise system tessdata
OCR_TESSDATA_DIR=
OCR_MAX_IMAGES=30
OCR_DPI=150
OCR_MIN_TEXT_CHARACTERS=80
OCR_PAGE_TIMEOUT_MS=15000
DOCUMENT_EXTRACT_TIMEOUT_MS=180000
# Optional native shared-library path; otherwise auto-detect macOS/Linux Tesseract 5.
OCR_TESSERACT_LIBRARY=
# Operator-only recovery API is disabled unless a private 32+ character token is set.
# Never put this in VITE_ variables, student requests or source control.
OPERATOR_RECOVERY_TOKEN=
