# Backend only. Leave optional pairs blank to disable their integration.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Render: one trusted reverse proxy hop. Keep zero for direct local access.
TRUST_PROXY_HOPS=0
# HTTPS Vercel frontend + Render API: none (requires NODE_ENV=production).
SESSION_SAME_SITE=lax
LOG_LEVEL=info
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Admin upload page only; PDFs are public. Use a unique random 16+ character password.
# Never put this password in VITE_ variables or commit your .env.
GALLERY_ADMIN_PASSWORD=
GEMINI_API_KEY=
# Optional Quick Ask failover key from a separate authorized account/project.
# Backend only: never put either key in VITE_ variables or commit backend/.env.
GEMINI_BACKUP_API_KEY=
AI_PRIMARY_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=freegg
# Legacy AI_PROVIDER remains supported (openrouter/freegg/gemini); new settings take priority.
# "groq" is accepted only as a deprecated alias for openrouter.
# Gemini Quick Ask is independent and unchanged.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_ENABLED=true
# Backend only. Paste your FreeGG bearer key here, without "Bearer " or quotes.
FREEGG_API_KEY=
FREEGG_BASE_URL=https://freegg.app/v1
FREEGG_MODEL=gpt-6.1-sol
FREEGG_ENABLED=true
FREEGG_MAX_OUTPUT_TOKENS=16384
# Only use a trusted HTTPS gateway; FREEGG_MODEL must be available to your account.
# Original PDFs (including scans) go directly to FreeGG; the OpenRouter model is text-only.
# Optional application bounds, not promises about any account's free quota:
AI_TIMEOUT_MS=120000
AI_JOB_TIMEOUT_MS=540000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
OPENROUTER_CONTEXT_TOKENS=1000000
OPENROUTER_MAX_OUTPUT_TOKENS=16384
AI_MAX_CONCURRENCY=1
AI_MAX_QUEUE=8
# OpenRouter free models allow 20 requests/minute; 3 seconds keeps one process below it.
AI_MIN_REQUEST_INTERVAL_MS=3000
AI_MAX_RETRIES=1
AI_MAX_RETRY_WAIT_MS=60000
AI_CHUNK_TOKENS=2000
# Fewer, larger batches for long sources; no text is dropped.
AI_LONG_SOURCE_CHUNK_TOKENS=12000
AI_CHUNK_OVERLAP_TOKENS=150
AI_MAX_CHUNKS=128
# Quick Ask uses Gemini independently; Detailed Ask uses OpenRouter with FreeGG fallback.
# Provider availability/latency cannot be guaranteed; use an explicit tutor model:
GEMINI_TUTOR_MODEL=gemini-3.5-flash-lite
# Only needed for Gemini study generation. Tutor-only use needs just GEMINI_API_KEY.
GEMINI_MODEL=
# Tested supported model: gemini-3.5-flash. Model listing alone does not prove generation access.
# Legacy settings retained for historical operator/test modules only.
# Active study/Ask routes never use a database or persistent cache.
# Gallery alone uses Supabase and manual migration 017.
WORKSPACE_YOUTUBE_STORE=local
LIBRARY_STORE=local_postgres
# Blank disables automatic extraction. Captions only; audio fallback is disabled.
TRANSCRIPTFETCH_API_KEY=
TRANSCRIPT_MAX_CHARACTERS=500000
TRANSCRIPT_MAX_DURATION_SECONDS=18000
# PDFs are sent directly to the study provider; no local OCR/Tesseract.
DOCUMENT_EXTRACT_TIMEOUT_MS=180000
