# ---------------------------------------------------------------------------
# LectureLensAI — frontend environment
#
# Copy this file to `.env.local` and adjust values as needed.
# `.env.local` is git-ignored.
#
# SECURITY: every VITE_* variable is compiled into the browser bundle and is
# public. Never put a secret, API key or service-role token in this file.
# ---------------------------------------------------------------------------

# Base URL of the backend API (includes the /api/v1 version prefix).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Public project configuration only. B3 calls the backend, not the database.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
